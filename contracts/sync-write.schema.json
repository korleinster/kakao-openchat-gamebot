{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "expectedVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "mutationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,80}$"
    },
    "list": {
      "type": "object",
      "properties": {
        "definitions": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "category": {
                "type": "string",
                "enum": [
                  "weekly",
                  "monthly",
                  "world_boss",
                  "content",
                  "collection"
                ]
              },
              "time": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              "weekdays": {
                "minItems": 1,
                "maxItems": 7,
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 7
                }
              },
              "anchor": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z)|(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?)$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "intervalMonths": {
                "type": "integer",
                "minimum": 0,
                "maximum": 24
              },
              "noticeDays": {
                "type": "integer",
                "minimum": 0,
                "maximum": 90
              },
              "enabled": {
                "type": "boolean"
              },
              "revision": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 2147483647
              },
              "leadMinutes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1440
              }
            },
            "required": [
              "id",
              "name",
              "category",
              "time",
              "weekdays",
              "anchor",
              "intervalMonths",
              "noticeDays",
              "enabled",
              "revision",
              "leadMinutes"
            ],
            "additionalProperties": false
          }
        },
        "summary": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "time": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            },
            "sendEmpty": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled",
            "time",
            "sendEmpty"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "definitions",
        "summary"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "expectedVersion",
    "mutationId",
    "list"
  ],
  "additionalProperties": false
}
